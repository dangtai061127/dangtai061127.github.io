---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../site';
export async function getStaticPaths() {
  const out: any[] = [];
  for (const kind of ['writeups', 'blog'] as const) {
    const posts = (await getCollection(kind, (p: any) => !p.data.draft)).sort((a: any, b: any) => +b.data.date - +a.data.date);
    posts.forEach((post: any, i: number) => out.push({ params: { kind, slug: post.id }, props: { post, kind, next: posts[i - 1], prev: posts[i + 1] } }));
  }
  return out;
}
const { post, kind, prev, next } = Astro.props;
const d = post.data as any;
const { Content, headings } = await render(post);
const toc = headings.filter((h: any) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;
const minutes = Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 200));
const mitre = (d.mitre ?? []).map((id: string) => ({ id, url: `https://attack.mitre.org/techniques/${id.replace('.', '/')}/` }));
const hasMeta = d.platform || d.difficulty || d.category || d.tools?.length || mitre.length;
---
<Base title={d.title} desc={d.summary} wide>
  <div class:list={['art', { 'has-toc': showToc }]}>
    {showToc && (
      <nav class="toc" aria-label="On this page">
        <p>On this page</p>
        {toc.map((h: any) => <a href={`#${h.slug}`} class:list={{ sub: h.depth === 3 }}>{h.text}</a>)}
      </nav>
    )}
    <article>
      <p class="pmeta">{d.date.toISOString().slice(0, 10)} · {minutes} min read <span id="views"></span></p>
      <h1>{d.title}</h1>
      {hasMeta && (
        <dl class="meta cut">
          {d.platform && <div><dt>Platform</dt><dd>{d.platform}</dd></div>}
          {d.difficulty && <div><dt>Difficulty</dt><dd>{d.difficulty}</dd></div>}
          {d.category && <div><dt>Category</dt><dd>{d.category}</dd></div>}
          {d.tools?.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
          {mitre.length > 0 && <div><dt>MITRE ATT&CK</dt><dd>{mitre.map((m: any, i: number) => <><a href={m.url}>{m.id}</a>{i < mitre.length - 1 ? ', ' : ''}</>)}</dd></div>}
        </dl>
      )}
      <div class="prose"><Content /></div>
      <p>{d.tags.map((t: string) => <span class="chip cut">{t}</span>)}</p>
      {(prev || next) && (
        <nav class="pager" aria-label="More posts">
          {prev ? <a href={`/${kind}/${prev.id}/`}><small>← Previous</small>{prev.data.title}</a> : <span></span>}
          {next && <a class="r" href={`/${kind}/${next.id}/`}><small>Next →</small>{next.data.title}</a>}
        </nav>
      )}
    </article>
  </div>
</Base>
<style>
.art{padding-top:1.5rem;max-width:800px;margin:0 auto}
article{min-width:0}
.toc{font:500 13.5px/1.4 var(--disp);border-left:1px solid var(--line);padding-left:16px;margin-bottom:2rem}
.toc p{font:500 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin:0 0 10px}
.toc a{display:block;color:var(--soft);padding:4px 0}
.toc a:hover{color:var(--cyan);text-decoration:none}
.toc a.sub{padding-left:12px;font-size:12.5px}
.pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line);font:600 16px/1.3 var(--disp)}
.pager a{color:var(--text)}
.pager a:hover{color:var(--cyan);text-decoration:none}
.pager small{display:block;font:500 12px var(--mono);color:var(--dim);margin-bottom:4px}
.pager .r{text-align:right;grid-column:2}
:global(.codebox){position:relative}
:global(.copy){position:absolute;top:8px;right:8px;font:500 12px var(--mono);color:var(--soft);background:var(--panel);border:1px solid var(--line);padding:2px 9px;cursor:pointer}
:global(.copy:hover){color:var(--text);border-color:var(--cyan)}
@media(min-width:1100px){
  .art.has-toc{max-width:1088px;display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:56px;align-items:start}
  .has-toc .toc{grid-column:2;grid-row:1;position:sticky;top:24px;max-height:calc(100vh - 48px);overflow-y:auto;margin:0}
  .has-toc article{grid-column:1;grid-row:1}
}
</style>
<script is:inline define:vars={{ gc: site.goatcounter }}>
if (gc !== 'YOUR-CODE') fetch(`https://${gc}.goatcounter.com/counter/${encodeURIComponent(location.pathname)}.json`).then(r => r.ok ? r.json() : null).then(j => { if (j) document.getElementById('views').textContent = `· ${j.count} views`; }).catch(() => {});
</script>
<script is:inline>
if (navigator.clipboard) document.querySelectorAll('.prose pre').forEach(pre => {
  const box = document.createElement('div');
  box.className = 'codebox';
  pre.replaceWith(box);
  box.append(pre);
  const b = document.createElement('button');
  b.type = 'button';
  b.className = 'copy';
  b.textContent = 'Copy';
  b.setAttribute('aria-label', 'Copy code');
  const say = t => { b.textContent = t; setTimeout(() => { b.textContent = 'Copy'; }, 1500); };
  b.onclick = () => navigator.clipboard.writeText(pre.innerText).then(() => say('Copied'), () => say('Failed'));
  box.append(b);
});
</script>
