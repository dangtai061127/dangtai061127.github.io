---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { links, profile } from '../site';
const writeups = (await getCollection('writeups', (p: any) => !p.data.draft)).sort((a: any, b: any) => +b.data.date - +a.data.date);
const featured = writeups.filter((p: any) => p.data.featured).slice(0, 3);
const cases = featured.length ? featured : writeups.slice(0, 3);
const [first, ...rest] = cases as any[];
const highlights = profile.achievements.slice(0, 3);
const proven = new Set(writeups.flatMap((p: any) => p.data.tags));
const sections = [cases.length && 'cases', highlights.length && 'highlights', profile.skills.length && 'skills'].filter(Boolean);
const num = (s: string) => String(sections.indexOf(s) + 1).padStart(2, '0');
const words = profile.headline.trim().split(' ');
const lastWord = words.pop();
const mitre = first?.data.mitre ?? [];

const hrefOf = (p: any) => `/writeups/${p.id}/`;
---
<Base wide>
  <div class="hero">
    <svg class="traces" viewBox="0 0 1088 650" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path d="M830 560V620H0" stroke="#2BD4F055"/><path class="flow" d="M830 560V620H0" stroke="#2BD4F0" stroke-width="2"/>
      <path d="M1088 170H1040L1010 200" stroke="#2BD4F033"/><path d="M1088 420H1036L1000 384" stroke="#2F6BFF55"/>
      <rect x="826" y="616" width="8" height="8" fill="#2BD4F0"/>
    </svg>
    <div>
      <p class="eyebrow">// {profile.role}</p>
      <h1>{words.join(' ')} <em>{lastWord}</em></h1>
      {profile.lead && <p class="lead">{profile.lead}</p>}
      <div class="acts">
        {profile.cv && <a class="btn" href={profile.cv}>Download CV</a>}
        <a class:list={['btn', { o: profile.cv }]} href="/writeups/">Read the case files</a>
      </div>
      <div class="plats">{links.map(([l, h]) => <a class="pbtn" href={h}>{l}</a>)}</div>
    </div>
    <div class="emblem">
      <div class="ring b"></div><div class="ring"></div>
      <div class="shield"><img src="/logo.png" width="512" height="512" alt="Knight holding a sword whose hilt is a key" /></div>
    </div>
  </div>

  {first && (
    <section style="padding-top:18px">
      <div class="h"><small>{num('cases')}</small><h2>Case files</h2></div>
      <div class="cases">
        <div class="card big"><div>
          {first.data.image && <img src={first.data.image} alt="" />}
          <span class="tag">{first.data.platform} {first.data.difficulty && <span class:list={['diff', first.data.difficulty.toLowerCase()]}>{first.data.difficulty}</span>} {first.data.category}</span>
          <div class="title"><a href={hrefOf(first)}>{first.data.title}</a></div>
          <p class="clamp">{first.data.summary}</p>
          <div class="chips">{first.data.tags.map((t: string) => <span class="chip cut">{t}</span>)}</div>
          {mitre.length > 0 && (
            <div class="chain">{mitre.slice(0, 4).map((id: string) => <a href={`https://attack.mitre.org/techniques/${id.replace('.', '/')}/`}>{id}</a>)}</div>
          )}
          <div class="pills">
            {mitre.length > 4 && <span class="pill">{`+${mitre.length - 4} more`}</span>}
            {first.data.tools.map((t: string) => <span class="pill">{t}</span>)}
          </div>
          <span class="go">Open case →</span>
        </div></div>
        <div class="side">
          {rest.map((p: any) => (
            <a class="card" href={hrefOf(p)}><div>
              {p.data.image && <img src={p.data.image} alt="" />}
              <span class="tag">{p.data.platform} {p.data.difficulty && <span class:list={['diff', p.data.difficulty.toLowerCase()]}>{p.data.difficulty}</span>} {p.data.category}</span>
              <div class="title">{p.data.title}</div>
              <p class="clamp">{p.data.summary}</p>
              <div class="chips">{p.data.tags.map((t: string) => <span class="chip cut">{t}</span>)}</div>
              <span class="go">Open case →</span>
            </div></a>
          ))}
          {cases.length < 3 && (
            <a class="card" href="/writeups/"><div>
              <span class="tag">Archive</span>
              <div class="title">All case files</div>
              <p>Browse every investigation.</p>
              <span class="go">Browse →</span>
            </div></a>
          )}
        </div>
      </div>
    </section>
  )}

  {highlights.length > 0 && (
    <section>
      <div class="h"><small>{num('highlights')}</small><h2>Highlights</h2></div>
      <div class="band">
        {highlights.map((a: any) => <div><div class="badge"></div><div><div class="t">{a.title}</div><small>{a.meta}</small></div></div>)}
      </div>
    </section>
  )}

  {profile.skills.length > 0 && (
    <section>
      <div class="h"><small>{num('skills')}</small><h2>Skills, with evidence</h2></div>
      <div class="skills">
        {profile.skills.map((s: any) => proven.has(s.tag)
          ? <a class="skill" href={`/writeups/?tag=${encodeURIComponent(s.tag)}`}>{s.name}<span>See the work →</span></a>
          : <div class="skill">{s.name}</div>)}
      </div>
    </section>
  )}
</Base>

<style>
.hero{position:relative;display:grid;grid-template-columns:1.12fr .88fr;align-items:center;min-height:610px;gap:20px;padding-bottom:40px}
.traces{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}
.hero>div{position:relative}
.eyebrow{font:500 13px var(--mono);letter-spacing:.16em;color:var(--cyan);margin:0 0 20px;text-transform:uppercase}
h1{font:700 74px/1.03 var(--disp);letter-spacing:-.015em;margin:0}
h1 em{font-style:normal;background:linear-gradient(90deg,var(--a1),var(--a2) 60%,var(--a3));-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{font-size:19px;color:var(--soft);max-width:540px;margin:24px 0 0}
.acts{margin-top:32px}
.plats{margin-top:26px}


.emblem{display:grid;place-items:center}
.emblem .shield{width:min(490px,100%);position:relative}
.ring{position:absolute;width:430px;height:430px;border-radius:50%;border:1px dashed #2BD4F040;animation:r 60s linear infinite}
.ring.b{width:520px;height:520px;border:1px solid #2F6BFF22;animation-duration:90s}
.ring:after{content:'';position:absolute;top:-4px;left:50%;width:8px;height:8px;background:var(--cyan);transform:rotate(45deg);box-shadow:0 0 14px var(--cyan)}
@keyframes r{to{transform:rotate(360deg)}}
.flow{stroke-dasharray:6 140;animation:f 5s linear infinite}
@keyframes f{to{stroke-dashoffset:-146}}
@media(prefers-reduced-motion:reduce){.ring,.flow{animation:none}}
section{padding:58px 0 8px;position:relative}
.cases{display:grid;grid-template-columns:1.5fr 1fr;gap:22px}
.side{display:grid;gap:22px}
.side .card:nth-child(3n+1){--c:var(--a3)}.side .card:nth-child(3n+2){--c:var(--a2)}
.cases img{display:block;max-width:none;width:calc(100% + 64px);margin:-30px -32px 18px;height:170px;object-fit:cover;object-position:left top}
.big img{width:calc(100% + 76px);margin:-36px -38px 20px;height:250px}
.clamp{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
.big .title{font-size:40px}
.big .title a{color:inherit}
.big .title a:after{content:'';position:absolute;inset:0}
.big>div{padding:36px 38px;background:radial-gradient(420px 240px at 92% 0,#1d4bb044,transparent),linear-gradient(155deg,#12264f,#0a1326 62%)}
.chain{display:grid;grid-template-columns:repeat(4,1fr);margin:30px 0 22px;border-top:1px solid #2BD4F066}
.chain a{position:relative;z-index:1;padding:14px 12px 0 0;font:500 13.5px var(--mono);color:var(--text)}
.chain a:before{content:'';position:absolute;top:-5px;left:0;width:9px;height:9px;background:var(--cyan);transform:rotate(45deg);box-shadow:0 0 12px var(--cyan)}
.pills{display:flex;flex-wrap:wrap;gap:6px}
.pill{font:500 12.5px var(--mono);color:var(--soft);background:#ffffff0a;padding:5px 11px}
.band{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}
.band>div{padding:28px 30px;display:flex;gap:18px;align-items:center}
.band>div+div{border-left:1px solid var(--line)}
.t{font:700 20px/1.2 var(--disp)}
.band small{font:500 12.5px var(--mono);color:var(--dim)}
.skills{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.skill{display:block;background:var(--panel);border-top:2px solid var(--c,var(--a1));padding:20px 20px 18px;font:700 19px/1.25 var(--disp);color:var(--text)}
.skill:nth-child(3n+2){--c:var(--a2)}.skill:nth-child(3n){--c:var(--a3)}
a.skill:hover{text-decoration:none;border-color:var(--cyan)}
.skill span{display:block;font:500 13px var(--mono);color:var(--cyan);margin-top:14px}
@media(max-width:400px){.skills{grid-template-columns:1fr!important}}
@media(max-width:860px){
  h1{font-size:46px}
  .hero,.cases,.band{grid-template-columns:1fr}
  .hero{min-height:0;padding-top:10px}
  .band>div+div{border-left:0;border-top:1px solid var(--line)}
  .skills{grid-template-columns:1fr 1fr}
  .emblem{order:-1}
  .emblem .shield{width:min(160px,100%)}
  .ring,.traces{display:none}
  .chain{grid-template-columns:1fr 1fr;gap:12px;border:0}
  .big .title{font-size:32px}
  .big>div{padding:28px 24px}
  .big img{width:calc(100% + 48px);margin:-28px -24px 18px;height:190px}
}
</style>
