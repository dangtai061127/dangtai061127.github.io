---
import { site, links } from '../site';
const { title, desc = 'Blue team portfolio, writeups and notes.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [['Home', '/'], ['About', '/about/'], ['Writeups', '/writeups/'], ['Blog', '/blog/']];
const gc = site.goatcounter !== 'YOUR-CODE';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} | ${site.name}` : site.name}</title>
  <meta name="description" content={desc} />
  <link rel="icon" href="/logo.png" />
  <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
  {gc && <script is:inline data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
</head>
<body>
<div class="bg" aria-hidden="true"></div>
<header><div class="wrap nav">
  <a class="brand" href="/">{site.name}</a>
  <nav aria-label="Main">{nav.map(([l, h]) => <a href={h} aria-current={(h === '/' ? path === '/' : path.startsWith(h)) ? 'page' : undefined}>{l}</a>)}</nav>
</div></header>
<main class:list={['wrap', { wide }]}><slot /></main>
<footer><div class="wrap foot">
  <span>© {site.name}</span>
  <span class="foot-links">{links.map(([l, h]) => <a href={h}>{l}</a>)}<a href="/rss.xml">RSS</a></span>
</div></footer>
<style is:global>
:root{--bg:#050913;--panel:#0B1427;--line:#1C2D50;--blue:#2F6BFF;--cyan:#2BD4F0;--a1:#2BD4F0;--a2:#8B5CF6;--a2t:#A78BFA;--a3:#F0468F;--text:#E7EEFB;--soft:#A7B6D2;--dim:#71829F;--disp:'Chakra Petch',sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace;--sans:'IBM Plex Sans',system-ui,sans-serif}
*{box-sizing:border-box}
html{background:var(--bg);color:var(--text);font:17px/1.65 var(--sans)}
body{margin:0;position:relative;overflow-x:clip}
[hidden]{display:none!important}
a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.bg{position:absolute;inset:0 0 auto;height:900px;background:radial-gradient(900px 620px at 76% 150px,#2c1a6b 0,#141046 38%,transparent 72%)}
.bg:before{content:'';position:absolute;inset:0;background-image:linear-gradient(#2F6BFF0d 1px,transparent 1px),linear-gradient(90deg,#2F6BFF0d 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:linear-gradient(#000,transparent 720px);mask-image:linear-gradient(#000,transparent 720px)}
header,main,footer{position:relative}
.wrap{max-width:1200px;margin:0 auto;padding-inline:56px}
main.wrap{max-width:912px;padding-block:2.5rem 4rem}
main.wrap.wide{max-width:1200px;padding-block:0 1rem}
.nav{display:flex;align-items:center;justify-content:space-between;height:78px}
.brand{font:700 17px var(--disp);color:var(--text);letter-spacing:.02em}
.brand:hover{text-decoration:none}
nav[aria-label=Main]{display:flex;gap:34px;font:500 15px var(--disp)}
nav[aria-label=Main] a{color:var(--soft)}
nav[aria-label=Main] a:hover{color:var(--text);text-decoration:none}
nav[aria-label=Main] a[aria-current]{color:var(--text);box-shadow:0 8px 0 -6px var(--cyan)}
.foot{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:50px;padding-block:26px;font:500 13px var(--mono);color:var(--dim)}
footer{border-top:1px solid var(--line)}
.foot-links{display:flex;flex-wrap:wrap;gap:18px}
.foot-links a{color:var(--soft)}
h1,h2,h3,.title,.pager a{overflow-wrap:anywhere}
h1,h2,h3{font-family:var(--disp);line-height:1.2;letter-spacing:-.01em}
h1{font-size:2.3rem;margin:0 0 1.5rem}
.dim{color:var(--dim)}
.cut{clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,0 100%)}
/* the logo PNG has an opaque background: clip it to the shield so the glow follows the shield */
.shield{filter:drop-shadow(0 0 46px #8B5CF6b0) drop-shadow(0 0 120px #F0468F33)}
.shield img{display:block;width:100%;height:auto;clip-path:polygon(26.6% 11.8%,73.4% 11.8%,80.8% 18.9%,80.8% 58.4%,50% 88.7%,19.2% 58.4%,19.2% 18.9%)}
.btn{display:inline-block;font:700 15px var(--disp);padding:14px 26px;background:linear-gradient(120deg,#7c3aed,#d02a78);color:#fff;clip-path:polygon(13px 0,100% 0,100% calc(100% - 13px),calc(100% - 13px) 100%,0 100%,0 13px);margin-right:10px}
.btn:hover{text-decoration:none;filter:brightness(1.12)}
.btn.o{background:#14233f;color:var(--text)}
/* clip-path cuts off an outer outline, so these draw focus inside the shape */
.btn:focus-visible,.pbtn:focus-visible,a.card:focus-visible>div{outline:2px solid #fff;outline-offset:-5px}
.plats{display:flex;flex-wrap:wrap;gap:8px}
.pbtn{display:inline-flex;align-items:center;gap:8px;font:600 13px var(--disp);padding:9px 15px;background:#14233f;color:var(--text);clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px)}
.pbtn:hover{text-decoration:none;filter:brightness(1.3)}
.pbtn:before{content:'';width:7px;height:7px;transform:rotate(45deg);background:var(--a1)}
.pbtn:nth-child(3n+2):before{background:var(--a2t)}.pbtn:nth-child(3n):before{background:var(--a3)}
.diff{display:inline-block;font:600 12px var(--mono);color:#050913;padding:0 7px;background:var(--soft)}
.diff.easy{background:#3DDC97}.diff.medium{background:#FFB000}.diff.hard{background:var(--a3)}.diff.insane{background:var(--a2t)}
.chips{margin-top:14px}
.h{display:flex;align-items:center;gap:16px;margin-bottom:30px}
.h small{font:500 13px var(--mono);color:var(--a2t)}
.h h2{font:700 34px/1.1 var(--disp);margin:0;letter-spacing:-.01em}
.h:after{content:'';flex:1;height:1px;background:linear-gradient(90deg,var(--a2),transparent)}
.card{display:block;position:relative;padding:1px;color:inherit;background:linear-gradient(140deg,var(--c,var(--a1)),#8B5CF655 40%,var(--line));clip-path:polygon(0 0,calc(100% - 26px) 0,100% 26px,100% 100%,26px 100%,0 calc(100% - 26px))}
a.card:hover{text-decoration:none;background:linear-gradient(140deg,var(--c,var(--a1)),var(--a2) 60%,var(--line))}
.card>div{height:100%;padding:30px 32px;background:linear-gradient(155deg,#12264f,#0a1326 62%);clip-path:inherit}
.card p{margin:0;color:var(--soft);font-size:16px}
.tag{font:500 12.5px var(--mono);color:var(--cyan);letter-spacing:.04em}
.title{font:700 26px/1.2 var(--disp);margin:8px 0 10px}
.go{display:inline-block;font:600 14.5px var(--disp);color:var(--cyan);margin-top:18px}
.badge{flex:none;width:46px;height:54px;background:linear-gradient(160deg,var(--a1),var(--a2));clip-path:polygon(0 0,100% 0,100% 62%,50% 100%,0 62%)}
.chip{font:.75rem var(--mono);padding:.15rem .65rem;border:1px solid var(--a1);color:var(--a1);background:none;margin:0 .4rem .4rem 0;display:inline-block}
button.chip:focus-visible{outline-offset:-2px}
.chip:nth-child(3n+2){color:var(--a2t);border-color:var(--a2)}.chip:nth-child(3n){color:var(--a3);border-color:var(--a3)}
button.chip{cursor:pointer}button.chip[aria-pressed=true]{border-color:var(--cyan);color:var(--text);background:#8B5CF644}
.post{display:block;padding:1rem 0 .6rem 1rem;border-left:2px solid var(--line);margin-bottom:.6rem;color:var(--text)}
.post:hover{border-color:var(--a2);background:linear-gradient(90deg,#8B5CF61f,transparent);text-decoration:none}
.post h2{font-size:1.25rem;margin:.1rem 0 .3rem}.post p{margin:0 0 .5rem;color:var(--soft)}
.post.has-img{display:grid;grid-template-columns:1fr 160px;gap:1rem;align-items:center;padding-right:.6rem}
.post img{width:160px;aspect-ratio:16/9;object-fit:cover;border:1px solid var(--line)}
.post time,.pmeta{font:.8rem var(--mono);color:var(--dim)}
.meta{background:var(--panel);border-left:2px solid var(--a2);padding:1rem 1.25rem;margin:1.25rem 0 2rem;font-size:.9rem}
.meta div{display:flex;gap:1rem;padding:.15rem 0}.meta dt{font-family:var(--mono);color:var(--dim);min-width:7.5rem}.meta dd{margin:0;overflow-wrap:anywhere}
.prose{overflow-wrap:break-word}
.prose h2{margin-top:2.2rem;font-size:1.5rem}.prose h3{font-size:1.2rem}
.prose img{max-width:100%;height:auto;border:1px solid var(--line)}
.prose pre{background:var(--panel)!important;border:1px solid var(--line);padding:1rem;overflow-x:auto;font-size:.85rem}
.prose code{font-family:var(--mono);font-size:.88em}.prose :not(pre)>code{background:var(--panel);padding:.1rem .35rem}
.prose table{border-collapse:collapse;display:block;overflow-x:auto}.prose th,.prose td{border:1px solid var(--line);padding:.4rem .7rem}
.prose blockquote{margin:1rem 0;padding-left:1rem;border-left:2px solid var(--line);color:var(--soft)}
@media(max-width:860px){.wrap{padding-inline:20px}.nav{height:auto;min-height:78px;flex-wrap:wrap;gap:6px 14px;padding-block:14px}nav[aria-label=Main]{gap:14px;font-size:13.5px}.brand{font-size:14px}.h h2{font-size:28px}.post.has-img{grid-template-columns:1fr}.post img{width:100%}.meta div{flex-direction:column;gap:0}}
</style>
</body></html>
